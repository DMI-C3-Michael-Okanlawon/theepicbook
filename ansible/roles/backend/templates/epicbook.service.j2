[Unit]
Description=EpicBook Node application
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=epicbook
Group=epicbook
WorkingDirectory=/opt/epicbook
Environment=NODE_ENV=production
Environment=PORT=8080
EnvironmentFile=/etc/epicbook/epicbook.env
ExecStart=/usr/bin/node /opt/epicbook/server.js
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
